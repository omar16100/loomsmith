{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "command_schema_version": {
      "type": "number",
      "const": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "commands": {
      "minItems": 1,
      "maxItems": 10000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "insert"
              },
              "collection": {
                "type": "string",
                "enum": [
                  "harnesses",
                  "parts",
                  "connectors",
                  "contacts",
                  "splices",
                  "ground_points",
                  "wires",
                  "nodes",
                  "segments",
                  "matings",
                  "assets",
                  "evidence",
                  "reviews",
                  "view_positions"
                ]
              },
              "entity": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "op",
              "collection",
              "entity"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "update"
              },
              "collection": {
                "type": "string",
                "enum": [
                  "harnesses",
                  "parts",
                  "connectors",
                  "contacts",
                  "splices",
                  "ground_points",
                  "wires",
                  "nodes",
                  "segments",
                  "matings",
                  "assets",
                  "evidence",
                  "reviews",
                  "view_positions"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "set": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "expect": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "op",
              "collection",
              "id",
              "set"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "delete"
              },
              "collection": {
                "type": "string",
                "enum": [
                  "harnesses",
                  "parts",
                  "connectors",
                  "contacts",
                  "splices",
                  "ground_points",
                  "wires",
                  "nodes",
                  "segments",
                  "matings",
                  "assets",
                  "evidence",
                  "reviews",
                  "view_positions"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,128}$"
              },
              "expect_entity": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "op",
              "collection",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "update_project"
              },
              "set": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "expect": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "op",
              "set"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "batch_id",
    "document_id",
    "command_schema_version",
    "expected_revision",
    "created_at",
    "commands"
  ],
  "additionalProperties": false
}
